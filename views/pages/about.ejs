<%- include("../partials/head") %>
<%- include("../partials/header") %>

      <section aria-labelledby="story-h">
        <h1 id="story-h">My Story <span class="emoji" aria-hidden="true">📖</span></h1>
        <div class="split">
          <div>
            <% site.story.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
            <% if (site.facts) { %>
            <ul class="facts">
              <% site.facts.forEach(fact => { %><li><span aria-hidden="true"><%= fact.emoji %></span> <%= fact.text %></li><% }) %>
            </ul>
            <% } %>
          </div>
          <%- include("../partials/photo", { src: site.photos.about, alt: site.name }) %>
        </div>
      </section>

      <% if (site.journey) { %>
      <section aria-labelledby="journey-h">
        <h2 id="journey-h">How I Got Here <span class="emoji" aria-hidden="true">🗺️</span></h2>
        <ol class="timeline">
          <% site.journey.forEach(chapter => { %>
          <li class="chapter">
            <p class="when"><span class="date"><%= chapter.date %></span><% if (chapter.place) { %> &middot; <%= chapter.place %><% } %></p>
            <h3><%= chapter.title %></h3>
            <% chapter.blocks.forEach(block => { %>
            <% if (block.p) { %><p><%= block.p %></p>
            <% } else if (block.html) { %><p><%- block.html %></p>
            <% } else if (block.lesson) { %><p class="lesson"><span class="label"><%= block.label || "What it taught me" %>:</span> <%= block.lesson %></p>
            <% } else if (block.photo) { %>
            <figure class="story-photo">
              <img src="<%= block.photo %>" alt="<%= block.alt %>" width="<%= block.width %>" height="<%= block.height %>" loading="lazy">
              <% if (block.caption) { %><figcaption><%= block.caption %></figcaption><% } %>
            </figure>
            <% } %>
            <% }) %>
          </li>
          <% }) %>
        </ol>
      </section>
      <% } %>

      <section aria-labelledby="skills-h" class="skills">
        <h2 id="skills-h">Skills <span class="emoji" aria-hidden="true">🧰</span></h2>
        <% site.skills.forEach(group => { %>
        <p><span class="label"><%= group.label %>:</span> <%= group.items %></p>
        <% }) %>
      </section>

      <% if (site.strengths) { %>
      <section aria-labelledby="strengths-h" class="strengths">
        <h2 id="strengths-h">My Strengths <span class="emoji" aria-hidden="true">🧭</span></h2>
        <p class="top5">CliftonStrengths Top 5: <%= site.strengths.top5.join(" · ") %></p>
        <% site.strengths.highlights.forEach(item => { %>
        <p><span class="label"><%= item.label %>:</span> <%= item.text %></p>
        <% }) %>
      </section>
      <% } %>

      <section aria-labelledby="edu-h" class="edu">
        <h2 id="edu-h">Education <span class="emoji" aria-hidden="true">🎓</span></h2>
        <% site.education.forEach(degree => { %>
        <h3><%= degree.title %> <span class="year">(<%= degree.year %>)</span></h3>
        <p><%= degree.detail %></p>
        <% }) %>
        <% if (site.certifications && site.certifications.length) { %>
        <h3>Certifications</h3>
        <% site.certifications.forEach((cert, i) => { %>
        <p<% if (i < site.certifications.length - 1) { %> class="cert"<% } %>><%= cert.name %> &middot; <%= cert.issuer %> &middot; <%= cert.date %><% if (cert.url) { %> &middot; <a href="<%= cert.url %>" target="_blank" rel="noopener">Verify</a><% } %></p>
        <% }) %>
        <% } %>
        <% if (site.recognition) { %>
        <h3>Recognition</h3>
        <p><%= site.recognition %></p>
        <% } %>
      </section>

      <section id="work" aria-labelledby="experience-h">
        <h2 id="experience-h">My Work <span class="emoji" aria-hidden="true">💼</span></h2>
        <ul class="jobs">
          <% site.jobs.forEach(job => { %>
          <li>
            <% const proj = job.project && site.projects.find(p => p.id === job.project); %>
            <h3><% if (proj) { %><a href="/projects/<%= proj.id %>/" title="See related projects"><%= job.title %><span class="go" aria-hidden="true">&rarr;</span></a><% } else { %><%= job.title %><% } %></h3>
            <p class="where"><%= job.org %> &middot; <%= job.dates %></p>
            <p><%= job.summary %></p>
          </li>
          <% }) %>
        </ul>
        <p style="margin-top:1.25rem"><a href="/projects/">Check out the projects I've built</a></p>
      </section>

      <% if (site.cta) { %>
      <section class="cta" aria-labelledby="cta-h">
        <h2 id="cta-h"><%= site.cta.title %></h2>
        <p><%= site.cta.text %></p>
        <div class="btns">
          <a class="btn primary" href="mailto:<%= site.links.email %>">Email me</a>
          <a class="btn" href="<%= site.links.linkedin %>" target="_blank" rel="noopener">Connect on LinkedIn</a>
        </div>
      </section>
      <% } %>

<%- include("../partials/footer") %>
