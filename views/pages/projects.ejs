<%- include("../partials/head") %>
<%- include("../partials/header") %>

      <section aria-labelledby="projects-h">
        <h1 id="projects-h">Projects <span class="emoji" aria-hidden="true">🛠️</span></h1>
        <p class="lede">Things I've built to take manual work off people's plates.</p>
        <ul class="projects">
          <% site.projects.forEach(project => { %>
          <li class="project" id="<%= project.id %>">
            <%- include("../partials/project-card", { project }) %>
          </li>
          <% }) %>
        </ul>
      </section>

<%- include("../partials/footer") %>
