<%- include("../partials/head") %>
<%- include("../partials/header") %>
<% const featured = site.projects.find(p => p.id === site.home.featuredProject); %>

      <section class="hero">
        <div>
          <h1>Hi, I'm <%= site.name.split(" ")[0] %> <span class="emoji" aria-hidden="true">👋</span></h1>
          <p class="lede"><%= site.home.tagline %></p>
          <p><%= site.home.intro %></p>
          <div class="btns">
            <a class="btn primary" href="/projects/">See my projects</a>
            <a class="btn" href="/about/">About me</a>
            <a class="btn" href="<%= site.links.resume %>">Resume</a>
          </div>
        </div>
        <%- include("../partials/photo", { src: site.photos.headshot, alt: site.name }) %>
      </section>

      <section aria-labelledby="focus-h">
        <h2 id="focus-h">What I Do <span class="emoji" aria-hidden="true">🧭</span></h2>
        <ul class="focus-list">
          <% site.home.focus.forEach(item => { %>
          <li><span class="emoji" aria-hidden="true"><%= item.emoji %></span><h3><%= item.title %></h3><p><%= item.text %></p></li>
          <% }) %>
        </ul>
      </section>

      <% if (featured) { %>
      <section aria-labelledby="featured-h">
        <h2 id="featured-h">Featured Project <span class="emoji" aria-hidden="true">⭐</span></h2>
        <div class="project">
          <%- include("../partials/project-card", { project: featured, showStack: false, extraLink: { href: "/projects/", label: "All projects" } }) %>
        </div>
      </section>
      <% } %>

<%- include("../partials/footer") %>
