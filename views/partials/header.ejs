<%
  const navLinks = [
    { key: "home", label: "Home", href: "/", icon: '<path d="M12 3 2 11h3v9h5v-6h4v6h5v-9h3L12 3Z"/>' },
    { key: "about", label: "About Me", href: "/about/", icon: '<path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5Z"/>' },
    { key: "projects", label: "Projects", href: "/projects/", icon: '<path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Zm4 3v2h10V8H7Zm0 4v2h7v-2H7Z"/>' },
  ];
%>
  <header class="banner">
    <div class="banner-top">
      <svg class="banner-art" viewBox="0 0 1200 68" preserveAspectRatio="none" aria-hidden="true">
        <rect width="1200" height="68" fill="#1b4332"/>
        <path d="M0 40 C 180 18, 330 52, 520 30 S 860 12, 1020 30 S 1150 40, 1200 26 V68 H0Z" fill="#23513b" opacity="0.9"/>
        <path d="M0 52 C 220 36, 380 64, 600 46 S 920 34, 1200 50 V68 H0Z" fill="#2d6a4f" opacity="0.85"/>
      </svg>
      <svg class="banner-peak" viewBox="0 0 140 68" aria-hidden="true">
        <path d="M8 68 L52 22 L66 36 L86 10 L132 68Z" fill="#52896a"/>
        <path d="M86 10 L78 20 L84 18 L88 24 L92 17 L97 21Z" fill="#e8f3ec"/>
        <path d="M52 22 L46 30 L52 28 L57 32Z" fill="#e8f3ec"/>
      </svg>
      <p class="banner-name"><a href="/"><%= site.name %></a></p>
    </div>
    <nav aria-label="Main">
      <ul>
        <% navLinks.forEach(link => { %>
        <li><a href="<%= link.href %>"<% if (page.key === link.key) { %> aria-current="page"<% } %>><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><%- link.icon %></svg><%= link.label %></a></li>
        <% }) %>
      </ul>
    </nav>
  </header>

  <main id="main">
    <div class="col">
